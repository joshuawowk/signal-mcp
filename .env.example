# Copy to .env. Do not commit .env.
# Sender: the signal-cli account registered on the host. The container
# uses this number when calling the daemon's `send` JSON-RPC method.
SIGNAL_SENDER=+14013752241

# Default recipient: Josh's personal Signal number. Tools accept a
# `recipient` override at call time.
SIGNAL_DEFAULT_RECIPIENT=+14018714110

# HTTP JSON-RPC endpoint (synchronous calls like send/version).
# With `network_mode: host` on Linux, 127.0.0.1 reaches the host daemon.
SIGNAL_RPC_URL=http://127.0.0.1:8080/api/v1/rpc

# TCP endpoint for streaming receive notifications. Requires the daemon
# to be started with `--tcp 127.0.0.1:7583`. The subscriber connects
# here as a persistent client.
SIGNAL_TCP_HOST=127.0.0.1
SIGNAL_TCP_PORT=7583

# Inbox retention in days. The subscriber prunes older entries on
# startup.
SIGNAL_INBOX_RETENTION_DAYS=14

# Path inside the container where inbox.jsonl is persisted.
SIGNAL_INBOX_PATH=/data/inbox.jsonl
